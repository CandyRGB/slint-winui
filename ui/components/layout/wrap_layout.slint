import { LayoutGeometry, LayoutSize } from "layout_geometry.slint";

export struct WrapLayoutChild {
    size: LayoutSize,
    row-span: int,
    column-span: int,
    collapsed: bool,
}

export struct WrapPanelPadding { left: length, top: length, right: length, bottom: length }
export enum WrapPanelItemsStretch { none, last }
export enum WrapGridAlignment { start, center, end, stretch }

export struct WrapPanelOptions {
    available: LayoutSize,
    orientation: Orientation,
    padding: WrapPanelPadding,
    item-spacing: length,
    line-spacing: length,
    stretch: WrapPanelItemsStretch,
    rtl: bool,
}

export struct VariableSizedWrapGridOptions {
    available: LayoutSize,
    orientation: Orientation,
    cell: LayoutSize,
    maximum-rows-or-columns: int,
    horizontal-alignment: WrapGridAlignment,
    vertical-alignment: WrapGridAlignment,
    rtl: bool,
}

export global WrapLayoutBehavior {
    pure callback wrap-panel([WrapLayoutChild], WrapPanelOptions) -> LayoutGeometry;
    pure callback variable-grid([WrapLayoutChild], VariableSizedWrapGridOptions) -> LayoutGeometry;
}
