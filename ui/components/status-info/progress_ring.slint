import { Palette } from "std-widgets.slint";

component ProgressRingArc inherits Path {
    in property <length> radius;
    in property <angle> start-angle;
    in property <angle> sweep-angle;
    private property <float> center: self.viewbox-width / 2;
    private property <angle> middle-angle: root.start-angle + root.sweep-angle / 2;
    private property <angle> end-angle: root.start-angle + root.sweep-angle;

    viewbox-width: self.width / 1px;
    viewbox-height: self.height / 1px;
    stroke-line-cap: round;
    visible: root.sweep-angle > 0deg;

    MoveTo {
        x: root.center + root.radius / 1px * cos(root.start-angle);
        y: root.center + root.radius / 1px * sin(root.start-angle);
    }
    // Two arcs keep the endpoints distinct even when the span is a full circle.
    ArcTo {
        radius-x: root.radius / 1px;
        radius-y: root.radius / 1px;
        x: root.center + root.radius / 1px * cos(root.middle-angle);
        y: root.center + root.radius / 1px * sin(root.middle-angle);
        sweep: true;
    }
    ArcTo {
        radius-x: root.radius / 1px;
        radius-y: root.radius / 1px;
        x: root.center + root.radius / 1px * cos(root.end-angle);
        y: root.center + root.radius / 1px * sin(root.end-angle);
        sweep: true;
    }
}

export component ProgressRing inherits Rectangle {
    in property <bool> is-active: true;
    in property <bool> is-indeterminate: true;
    in property <bool> animations-enabled: true;
    in-out property <float> minimum: 0;
    in-out property <float> maximum: 100;
    in-out property <float> value: 0;
    in property <color> foreground: Palette.accent-background;
    in property <color> track-color: transparent;
    in property <string> accessible-name: @tr("Progress");

    min-width: 16px;
    min-height: 16px;
    preferred-width: 32px;
    preferred-height: 32px;
    horizontal-stretch: 0;
    vertical-stretch: 0;

    private property <float> fraction: root.maximum > root.minimum
        ? clamp((root.value - root.minimum) / (root.maximum - root.minimum), 0, 1) : 0;
    private property <float> target-fraction;
    private property <float> shown-fraction;
    private property <duration> advance-duration;
    private property <duration> loop-start;
    private property <bool> spinning: root.is-active && root.is-indeterminate && root.animations-enabled;

    init => {
        if root.maximum < root.minimum {
            root.maximum = root.minimum;
        }
        root.clamp-value();
        root.target-fraction = root.fraction;
        root.shown-fraction = root.fraction;
        root.loop-start = animation-tick();
    }

    function clamp-value() {
        let clamped = clamp(root.value, root.minimum, root.maximum);
        if root.value != clamped {
            root.value = clamped;
        }
    }

    changed minimum => {
        if root.minimum > root.maximum {
            root.maximum = root.minimum;
        }
        root.clamp-value();
    }
    changed maximum => {
        if root.maximum < root.minimum {
            root.minimum = root.maximum;
        }
        root.clamp-value();
    }
    changed value => { root.clamp-value(); }
    changed spinning => { root.loop-start = animation-tick(); }

    changed fraction => {
        root.advance-duration = root.is-active && !root.is-indeterminate && root.animations-enabled
            && root.fraction > root.target-fraction
            ? 2s * max(0, root.fraction - root.shown-fraction) : 0ms;
        root.target-fraction = root.fraction;
        root.shown-fraction = root.fraction;
    }
    changed animations-enabled => {
        if !root.animations-enabled {
            root.advance-duration = 0ms;
            root.shown-fraction = root.fraction;
        }
    }
    animate shown-fraction {
        duration: root.advance-duration;
        easing: linear;
    }

    if root.is-active: Rectangle {
        private property <length> diameter: min(root.width, root.height);
        private property <length> thickness: max(2px,
            round(self.diameter / 2px * (root.is-indeterminate ? 7.5 / 80 : 2.655 / 32)) * 2px);
        private property <length> radius: min((self.diameter - self.thickness) / 2,
            round(self.diameter / 2px * (root.is-indeterminate ? 35 / 80 : 14.16 / 32)) * 2px);
        private property <float> phase: root.spinning ? mod(animation-tick() - root.loop-start, 2s) / 2s : 0.25;

        width: self.diameter;
        height: self.diameter;

        ProgressRingArc {
            width: parent.width;
            height: parent.height;
            radius: parent.radius;
            stroke: root.track-color;
            stroke-width: parent.thickness;
            sweep-angle: 360deg;
        }
        ProgressRingArc {
            width: parent.width;
            height: parent.height;
            radius: parent.radius;
            stroke: root.foreground;
            stroke-width: parent.thickness;
            start-angle: -90deg + (root.is-indeterminate ? 900deg * parent.phase + 360deg * max(0, parent.phase - 0.5) : 0deg);
            sweep-angle: 360deg * (root.is-indeterminate ? min(parent.phase, 1 - parent.phase) : root.shown-fraction);
        }
    }

    if root.is-active && root.is-indeterminate: Rectangle {
        accessible-role: progress-indicator;
        accessible-label: @tr("Busy {}", root.accessible-name);
    }
    if root.is-active && !root.is-indeterminate: Rectangle {
        accessible-role: progress-indicator;
        accessible-label: root.accessible-name;
        accessible-value: "\{root.value}";
        accessible-value-minimum: root.minimum;
        accessible-value-maximum: root.maximum;
        accessible-read-only: true;
    }
}
