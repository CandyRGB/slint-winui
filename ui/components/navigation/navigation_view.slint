            }
            top-list := NavigationViewList {
                visible: root.top-height > 0px;
                enabled: root.popup-owner == "";
                x: root.rtl ? 4px : root.top-controls-width + root.top-title-width + root.top-header-width + 4px;
                y: 4px;
                width: max(0px, root.width - root.top-controls-width - root.top-title-width - root.top-header-width - 8px);
                height: 40px;
                rows: self.visible ? root.top-layout.rows : [];
                label: "Navigation";
                rtl: root.rtl;
                horizontal: true;
                selected-id: root.selected-id;
                popup-owner: root.popup-owner;
                activated(row, chevron, anchor) => { root.activate-row(row, chevron, anchor, false); }
                focused(row) => { root.focus-item(row); }
            }
            left-search-button := NavigationViewButton {
                visible: root.show-pane-header && root.is-search-visible && !root.is-pane-open;
                enabled: root.popup-owner == "";
                x: round((parent.width - self.width) / 4px) * 2px;
                y: pane.controls-height + 4px;
                icon: @image-url("../../icons/search_16_regular.svg");
                label: root.search-placeholder;
                invoked => {
                    root.opened-from-search = true;
                    root.show-pane();
                    left-search.focus();
                }
            }
            left-search := AutoSuggestBox {
                visible: root.show-pane-header && root.is-search-visible && root.is-pane-open;
                enabled: self.visible && root.popup-owner == "";
                x: 12px;
                y: pane.controls-height + 4px;
                width: max(0px, parent.width - 24px);
                height: 32px;
                text <=> root.search-text;
                placeholder-text: root.search-placeholder;
                suggestions: root.search-suggestions;
                query-icon: @image-url("../../icons/search_16_regular.svg");
                popup-viewport: { width: root.width, height: root.height };
                text-changed(text, reason) => { if (self.visible) { root.search-text-changed(text, reason); } }
                suggestion-chosen(item) => { root.search-suggestion-chosen(item); }
                query-submitted(text, has-suggestion, item) => { root.search-submitted(text, has-suggestion, item); }
            }
            pane-custom-slot := Rectangle {
                clip: true;
                preferred-width: pane-custom-slot-layout.preferred-width;
                preferred-height: pane-custom-slot-layout.preferred-height;
                visible: self.preferred-height > 0px;
                x: root.top-mode ? top-list.x + (root.rtl ? top-list.width - root.top-layout.search-offset : root.top-layout.primary-end)
                    : root.rtl ? parent.width - self.width : 0px;
                y: root.top-mode ? 4px : pane.controls-height + pane.search-height;
                width: root.top-mode ? max(0px, root.top-layout.search-offset - root.top-layout.primary-end)
                    : root.is-pane-open ? parent.width : min(parent.width, self.preferred-width);
                height: root.top-mode ? 40px : pane.custom-height;
                pane-custom-slot-layout := HorizontalLayout { pane-custom-content { } }
            }
            top-search := AutoSuggestBox {
                visible: root.top-height > 0px && root.is-search-visible;
                enabled: self.visible && root.popup-owner == "";
                x: top-list.x + (root.rtl ? top-list.width - root.top-layout.search-offset - root.top-search-width : root.top-layout.search-offset) + 4px;
                y: 8px;
                width: max(0px, root.top-search-width - 8px);
                height: 32px;
                text <=> root.search-text;
                placeholder-text: root.search-placeholder;
                suggestions: root.search-suggestions;
                query-icon: @image-url("../../icons/search_16_regular.svg");
                popup-viewport: { width: root.width, height: root.height };
                text-changed(text, reason) => { if (self.visible) { root.search-text-changed(text, reason); } }
