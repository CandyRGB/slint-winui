                }
            }
            left-dismiss := NavigationViewButton {
                visible: pane.close-button;
                x: root.rtl ? parent.width - 44px : 4px;
                y: 6px;
                icon: @image-url("../../icons/dismiss_16_regular.svg");
                label: "Dismiss pane";
                invoked => { root.close-pane(NavigationViewCloseReason.close-button); }
            }
            top-title := Text {
                visible: root.top-height > 0px && root.pane-title != "";
                x: root.rtl ? root.width - root.top-controls-width - root.top-title-width + 8px : root.top-controls-width + 16px;
                y: 4px;
                width: max(0px, root.top-title-width - 24px);
                height: 40px;
                text: root.pane-title;
                vertical-alignment: center;
                horizontal-alignment: root.rtl ? right : left;
                font-size: 14px;
                font-weight: 600;
                overflow: elide;
                color: Palette.foreground;
            }
            left-toggle := NavigationViewButton {
                visible: !root.top-mode && root.is-pane-toggle-button-visible;
                x: root.rtl ? parent.width - pane.toggle-start - self.width : pane.toggle-start;
                y: pane.toggle-y;
                icon: @image-url("../../icons/navigation_16_regular.svg");
                label: root.is-pane-open ? "Close navigation" : "Open navigation";
                expandable: true;
                expanded: root.is-pane-open;
                invoked => { root.toggle-pane(); }
