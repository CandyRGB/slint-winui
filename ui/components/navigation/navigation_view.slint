    init => {
        root.is-pane-open = root.is-pane-visible && root.display-mode == NavigationViewDisplayMode.expanded;
        root.initialized = true;
    }
    changed pane-display-mode => { root.force-closed = false; root.update-pane(); }
    changed display-mode => {
        if (root.initialized) {
            root.update-pane();
            root.display-mode-changed(root.display-mode);
        }
    }
    changed is-pane-visible => { root.update-pane(); }
    changed selected-id => { if (root.initialized) { root.selection-changed(root.selected-id); } }
    changed width => { if (root.popup-owner != "") { root.close-popup(true, ""); } }
    changed height => { if (root.popup-owner != "") { root.close-popup(true, ""); } }

    public function show-pane() {
        if (!root.is-pane-open && root.is-pane-visible && !root.top-mode) {
            root.force-closed = false;
            root.pane-opening();
            root.is-pane-open = true;
            if (root.overlay) { root.focus-pane-start(); }
            root.pane-opened();
        }
    }
    public function hide-pane() { root.close-pane(NavigationViewCloseReason.programmatic); }
    public function toggle-pane() {
        if (root.is-pane-open) { root.close-pane(NavigationViewCloseReason.toggle); }
        else { root.show-pane(); }
    }

    function update-pane() {
        root.close-popup(false, "");
