    top-toggle := NavigationViewButton {
        visible: root.show-top-toggle && !root.overlay;
        x: root.rtl ? root.width - root.top-controls-width + 4px : root.top-controls-width - 44px;
        y: root.title-bar-padding + 6px;
        icon: @image-url("../../icons/navigation_16_regular.svg");
        label: "Open navigation";
        expandable: true;
        invoked => { root.show-pane(); }
    }

    if root.overlay : Rectangle {
        z: 1;
        y: root.title-bar-padding;
        height: max(0px, root.height - self.y);
