        root.footer-menu-items, root.settings-item, root.metrics, root.top-layout-selection, top-list.width,
        { custom: root.top-custom-min-width, search: root.top-search-width, footer: root.top-footer-width }) : {};
    private property <string> popup-owner;
    private property <string> overflow-layout-selection;
    private property <string> top-layout-selection: root.popup-owner == "$overflow" ? root.overflow-layout-selection : root.selected-id;
    private property <FlyoutRect> popup-target;
    private property <[NavigationViewRow]> popup-rows: NavigationViewBehavior.flyout-rows(root.menu-items, root.footer-menu-items,
