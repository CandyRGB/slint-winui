            left-title := Text {
                visible: !root.top-mode && root.is-pane-open && root.pane-title != "";
                private property <length> extent: self.visible ? min(ceil(self.preferred-width / 2px) * 2px + 8px, pane.heading-width) : 0px;
                x: root.rtl ? parent.width - pane.heading-start - self.extent : pane.heading-start + 8px;
                width: max(0px, self.extent - 8px);
                y: pane.toggle-y;
                height: 36px;
                text: root.pane-title;
                vertical-alignment: center;
                horizontal-alignment: root.rtl ? right : left;
                font-size: 14px;
                font-weight: 600;
                overflow: elide;
                color: Palette.foreground;
            }
            pane-header-slot := Rectangle {
