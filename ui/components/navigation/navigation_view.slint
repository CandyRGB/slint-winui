            pane-footer-slot := Rectangle {
                clip: true;
                preferred-width: pane-footer-slot-layout.preferred-width;
                preferred-height: pane-footer-slot-layout.preferred-height;
                visible: self.preferred-height > 0px;
                x: root.top-mode ? top-list.x + (root.rtl ? top-list.width - root.top-layout.footer-offset - self.width : root.top-layout.footer-offset)
                    : root.rtl ? parent.width - self.width : 0px;
                y: root.top-mode ? 4px : footer-list.y - pane.footer-height;
                width: root.top-mode ? root.top-footer-width : root.is-pane-open ? parent.width : min(parent.width, self.preferred-width);
                height: root.top-mode ? 40px : max(0px, pane.footer-height - 4px);
                pane-footer-slot-layout := HorizontalLayout { pane-footer { } }
            }
            footer-list := NavigationViewList {
                enabled: root.show-pane-header && root.popup-owner == "";
                y: parent.height - self.height;
                width: parent.width;
                height: root.left-layout.footer-height;
                rows: root.left-layout.footer;
                label: "Navigation footer";
                selected-id: root.selected-id;
                rtl: root.rtl;
                popup-owner: root.popup-owner;
                icon-only: !root.is-pane-open;
                activated(row, chevron, anchor) => { root.activate-row(row, chevron, anchor, false); }
                focused(row) => { root.focus-item(row); }
