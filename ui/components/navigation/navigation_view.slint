    pane := Rectangle {
        z: root.overlay ? 2 : 0;
        visible: root.top-mode ? root.top-height > 0px : root.show-pane-header;
        x: !root.top-mode && root.rtl ? root.width - root.pane-width : 0px;
        y: root.title-bar-padding;
        width: root.top-mode ? root.width : root.pane-width;
        height: root.top-mode ? root.top-height : max(0px, root.height - self.y);
        clip: !root.top-mode;
        background: root.overlay ? Palette.background : transparent;
        private property <bool> back: !root.top-mode && root.is-back-button-visible && root.display-mode != NavigationViewDisplayMode.minimal;
        private property <bool> close-button: root.overlay && root.display-mode == NavigationViewDisplayMode.minimal && root.is-back-button-visible;
        private property <length> toggle-y: pane.back ? 46px : 6px;
        private property <length> toggle-start: pane.close-button ? 44px : 4px;
        private property <length> search-height: root.is-search-visible ? 44px : 0px;
        private property <length> heading-start: self.toggle-start + (root.is-pane-toggle-button-visible ? 40px : 0px);
        private property <length> heading-width: max(0px, self.width - self.heading-start - 12px);
        private property <length> heading-height: root.is-pane-toggle-button-visible || root.pane-title != "" || pane-header-slot.visible
            ? max(48px, pane-header-slot.visible ? ceil(pane-header-slot.preferred-height / 2px) * 2px : 0px) : 0px;
        private property <length> controls-height: self.back ? (self.heading-height > 0px ? 40px + self.heading-height : 48px)
            : max(self.heading-height, self.close-button ? 48px : 0px);
        private property <length> custom-height: pane-custom-slot.visible
            ? clamp(ceil(pane-custom-slot.preferred-height / 2px) * 2px, 0px, max(0px, self.height - self.controls-height - self.search-height)) : 0px;
        private property <length> footer-height: pane-footer-slot.visible
            ? clamp(ceil(pane-footer-slot.preferred-height / 2px) * 2px + 4px, 0px, max(0px, self.height - self.controls-height - self.search-height - self.custom-height)) : 0px;
        private property <length> items-height: max(0px, self.height - self.controls-height - self.search-height - self.custom-height - self.footer-height);

        if root.overlay : Rectangle {
            x: root.rtl ? 0px : parent.width - 1px;
            width: 1px;
            background: Palette.foreground.with-alpha(0.10);
        }
        pane-key := FocusScope {
            enabled: root.overlay && root.popup-owner == "";
            focus-on-click: false;
            focus-on-tab-navigation: false;
            key-pressed(event) => {
                if (self.enabled && event.text == Key.Escape) {
                    root.close-pane(NavigationViewCloseReason.light-dismiss);
                    return accept;
                }
                return reject;
            }
            pane-start := FocusScope {
                enabled: pane-key.enabled;
                focus-on-click: false;
                focus-gained(reason) => { if (reason == FocusReason.tab-navigation) { root.schedule-pane-wrap(false); } }
            }
            left-back := NavigationViewButton {
                visible: pane.back;
                x: root.rtl ? parent.width - 44px : 4px;
                y: 6px;
                icon: root.rtl ? @image-url("../../icons/arrow_right_16_regular.svg") : @image-url("../../icons/arrow_left_16_regular.svg");
                label: "Back";
                enabled: root.overlay || root.is-back-enabled;
                invoked => {
                    if (root.overlay) { root.close-pane(NavigationViewCloseReason.back); }
