                private property <length> start: root.top-mode ? root.top-controls-width + root.top-title-width + 4px : pane.heading-start + left-title.extent;
                x: root.rtl ? parent.width - self.start - self.width : self.start;
                y: root.top-mode ? 4px : pane.toggle-y;
                width: root.top-mode ? root.top-header-width : max(0px, pane.heading-width - left-title.extent);
