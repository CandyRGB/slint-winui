            else if (root.show-top-toggle) { top-toggle.focus(); }
            else if (left-toggle.visible && pane.visible) { left-toggle.focus(); }
            else if (left-list.can-focus) { left-list.restore-focus(root.selected-id); }
            else if (footer-list.can-focus) { footer-list.restore-focus(root.selected-id); }
