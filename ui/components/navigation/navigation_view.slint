            }
        }
    }
    top-content-overlay := Rectangle {
    clip: true;
    preferred-width: top-content-overlay-layout.preferred-width;
    preferred-height: top-content-overlay-layout.preferred-height;
        visible: root.top-overlay-height > 0px;
        x: 0px;
        y: root.title-bar-padding + root.top-height;
        width: root.width;
        height: root.top-overlay-height;
        top-content-overlay-layout := HorizontalLayout { content-overlay { } }
    }

    content := Rectangle {
        x: root.rtl ? 0px : root.dock-width;
        y: root.page-top + root.header-height;
        width: max(0px, root.width - root.dock-width);
        height: max(0px, root.height - self.y);
        border-top-left-radius: root.dock-width > 0px && !root.rtl ? 8px : 0px;
        border-top-right-radius: root.dock-width > 0px && root.rtl ? 8px : 0px;
        border-width: 1px;
        border-color: Palette.foreground.with-alpha(0.06);
        background: Palette.background;
        clip: true;
        @children
    }
    page-header-slot := Rectangle {
    clip: true;
    preferred-width: page-header-slot-layout.preferred-width;
    preferred-height: page-header-slot-layout.preferred-height;
        visible: root.show-header && self.preferred-height > 0px;
        x: root.rtl ? 24px + (root.top-mode ? 0px : root.top-controls-width) : root.dock-width + (root.top-mode ? 0px : root.top-controls-width) + 24px;
        y: root.page-top;
        width: max(0px, root.width - root.dock-width - (root.top-mode ? 0px : root.top-controls-width) - 48px);
        height: root.header-height;
        page-header-slot-layout := HorizontalLayout { page-header { } }
    }
    if root.show-header && !page-header-slot.visible : Text {
        x: root.rtl ? 24px + (root.top-mode ? 0px : root.top-controls-width) : root.dock-width + (root.top-mode ? 0px : root.top-controls-width) + 24px;
        y: root.page-top;
        width: max(0px, root.width - root.dock-width - (root.top-mode ? 0px : root.top-controls-width) - 48px);
        height: root.header-height;
        text: root.header;
        vertical-alignment: center;
        horizontal-alignment: root.rtl ? right : left;
        font-size: 28px;
        font-weight: 600;
        overflow: elide;
        color: Palette.foreground;
    }
    TouchArea {
        z: 3;
        enabled: root.popup-owner != "";
        visible: self.enabled;
        clicked => { root.close-popup(true, ""); }
    }
    popup := Rectangle {
        z: 4;
        visible: root.popup-owner != "";
        x: root.popup-placement.x;
        y: root.popup-placement.y;
        width: root.popup-placement.width;
        height: root.popup-placement.height;
        background: Palette.background;
        border-radius: 8px;
        border-width: 1px;
        border-color: Palette.foreground.with-alpha(0.12);
        drop-shadow-blur: 16px;
        drop-shadow-offset-y: 4px;
        drop-shadow-color: #0003;
        TouchArea { }
        popup-list := NavigationViewList {
            y: 4px;
            width: parent.width;
            height: max(0px, parent.height - 8px);
            enabled: popup.visible;
            trap-tab: true;
            dismiss-on-escape: true;
            rows: root.popup-rows;
            label: root.popup-owner == "$overflow" ? "More navigation items" : "Child navigation items";
            rtl: root.rtl;
            selected-id: root.selected-id;
            activated(row, chevron, anchor) => { root.activate-row(row, chevron, anchor, true); }
            focused(row) => { root.focus-item(row); }
            escape => { root.close-popup(true, ""); }
        }
    }
}
