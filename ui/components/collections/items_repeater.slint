export struct ItemsRepeaterSize { width: length, height: length }

export struct ItemsRepeaterPlacement {
    index: int,
    key: string,
    x: length,
    y: length,
    width: length,
    height: length,
}

export enum ItemsRepeaterLayout { stack, uniform-grid, flow, custom, lined-flow }
export enum ItemsRepeaterJustification { start, center, end, space-around, space-between, space-evenly }
export enum ItemsRepeaterStretch { none, fill, uniform }

export struct ItemsRepeaterLayoutOptions {
    kind: ItemsRepeaterLayout,
    orientation: Orientation,
    rtl: bool,
    viewport: ItemsRepeaterSize,
    item-size: ItemsRepeaterSize,
    spacing: ItemsRepeaterSize,
    max-items-per-line: int,
    justification: ItemsRepeaterJustification,
    stretch: ItemsRepeaterStretch,
}

export struct ItemsRepeaterWindow {
    x: length,
    y: length,
    width: length,
    height: length,
    horizontal-cache-length: float,
    vertical-cache-length: float,
    virtualizing: bool,
}

export struct ItemsRepeaterGeometry {
    placements: [ItemsRepeaterPlacement],
    width: length,
    height: length,
}

export global ItemsRepeaterBehavior {
    in property <bool> ready;
    pure callback arrange(int, [string], [ItemsRepeaterSize], [ItemsRepeaterPlacement], ItemsRepeaterLayoutOptions) -> ItemsRepeaterGeometry;
    pure callback visible(ItemsRepeaterGeometry, ItemsRepeaterWindow) -> [ItemsRepeaterPlacement];
    callback update([ItemsRepeaterPlacement], [ItemsRepeaterPlacement]) -> [ItemsRepeaterPlacement];
}

export component ItemsRepeater inherits Rectangle {
    in property <int> item-count;
    in property <[string]> item-keys;
    in property <ItemsRepeaterLayout> layout: ItemsRepeaterLayout.stack;
    in property <Orientation> orientation: Orientation.vertical;
    in property <bool> rtl;
    in property <length> viewport-width;
    in property <length> viewport-height;
    in property <length> scroll-x;
    in property <length> scroll-y;
    in property <length> item-width: 96px;
    in property <length> item-height: 64px;
    in property <length> column-spacing;
    in property <length> row-spacing;
    in property <[ItemsRepeaterSize]> item-sizes;
    in property <[ItemsRepeaterPlacement]> custom-placements;
    in property <int> max-items-per-line: -1;
    in property <ItemsRepeaterJustification> justification: ItemsRepeaterJustification.start;
    in property <ItemsRepeaterStretch> stretch: ItemsRepeaterStretch.none;
    in property <bool> virtualizing: true;
    in property <float> horizontal-cache-length: 2;
    in property <float> vertical-cache-length: 2;

    out property <[ItemsRepeaterPlacement]> realized;
    out property <[ItemsRepeaterPlacement]> placements: geometry.placements;
    out property <length> extent-width: geometry.width;
    out property <length> extent-height: geometry.height;

    callback scroll-requested(length, length);

    private property <ItemsRepeaterGeometry> geometry: ItemsRepeaterBehavior.ready
        ? ItemsRepeaterBehavior.arrange(root.item-count, root.item-keys, root.item-sizes, root.custom-placements, {
            kind: root.layout,
            orientation: root.orientation,
            rtl: root.rtl,
            viewport: { width: root.viewport-width, height: root.viewport-height },
            item-size: { width: root.item-width, height: root.item-height },
            spacing: { width: root.column-spacing, height: root.row-spacing },
            max-items-per-line: root.max-items-per-line,
            justification: root.justification,
            stretch: root.stretch,
        }) : { placements: [], width: 0px, height: 0px };

    private property <[ItemsRepeaterPlacement]> wanted: ItemsRepeaterBehavior.ready
        ? ItemsRepeaterBehavior.visible(geometry, {
            x: root.scroll-x,
            y: root.scroll-y,
            width: root.viewport-width,
            height: root.viewport-height,
            horizontal-cache-length: root.horizontal-cache-length,
            vertical-cache-length: root.vertical-cache-length,
            virtualizing: root.virtualizing,
        }) : [];

    preferred-width: root.extent-width;
    preferred-height: root.extent-height;
    accessible-role: none;

    init => { root.sync-realized(); }
    changed wanted => { root.sync-realized(); }

    function sync-realized() {
        root.realized = ItemsRepeaterBehavior.update(root.realized, root.wanted);
    }

    public pure function placement(index: int) -> ItemsRepeaterPlacement {
        return index >= 0 && index < geometry.placements.length
            ? geometry.placements[index] : { index: -1, key: "", x: 0px, y: 0px, width: 0px, height: 0px };
    }

    public function scroll-into-view(index: int) {
        let target = root.placement(index);
        if target.index < 0 || target.width == 0px || target.height == 0px { return; }
        root.scroll-requested(
            root.reveal-axis(target.x, target.width, root.scroll-x, root.viewport-width, root.extent-width),
            root.reveal-axis(target.y, target.height, root.scroll-y, root.viewport-height, root.extent-height));
    }

    pure function reveal-axis(position: length, size: length, current: length, viewport: length, extent: length) -> length {
        let start = position < current || size >= viewport ? position
            : position + size > current + viewport ? position + size - viewport : current;
        return clamp(start, 0px, max(0px, extent - viewport));
    }

    @children
}
