import { Palette } from "std-widgets.slint";
import { ContextFlyoutArea } from "../dialogs-flyouts/context_flyout_area.slint";
import { FlyoutRect } from "../dialogs-flyouts/flyout_layout.slint";
import { TextBoxField, ScrollingTextInput } from "text_box_field.slint";

export enum PasswordRevealMode { peek, hidden, visible }

export struct PasswordMask {
    display: string,
    selected: string,
    selection-start: int,
}

export struct PasswordEdit {
    text: string,
    cursor: int,
}

export global PasswordBoxBehavior {
    in-out property <bool> allow-peek: true;
    pure callback mask-glyph(string) -> string;
    pure callback mask-text(string, string, int, int) -> PasswordMask;
    pure callback limit-edit(string, string, int, int) -> PasswordEdit;
    limit-edit(previous, draft, cursor, maximum) => { return { text: draft, cursor: cursor }; }
}

export component PasswordBox inherits Rectangle {
    in-out property <string> password;
    in property <string> password-char: "●";
    in property <PasswordRevealMode> password-reveal-mode: PasswordRevealMode.peek;
    in property <int> max-length;
    in property <string> header;
    in property <string> description;
    in property <string> placeholder-text;
    in property <string> accessible-name: root.header;
    in property <bool> enabled: true;
    in property <bool> allow-peek: PasswordBoxBehavior.allow-peek;
    in property <bool> rtl;
    in property <bool> context-enabled: true;
    in property <color> accent: Palette.accent-background;
    out property <bool> has-focus: input.has-focus;
    out property <bool> has-selection: input.anchor-position-byte-offset != input.cursor-position-byte-offset;
    out property <int> selection-anchor: max(0, input.anchor-position-byte-offset);
    out property <int> selection-cursor: max(0, input.cursor-position-byte-offset);
    out property <bool> reveal-button-visible: root.can-peek;
    out property <bool> is-password-revealed: root.password-reveal-mode == PasswordRevealMode.visible
        || (root.can-peek && (root.pointer-peek || root.key-peek || root.automation-peek));

    callback password-changing();
    callback password-changed();
    // Return true to cancel the pending edit or paste.
    callback before-password-changing(string) -> bool;
    callback paste-requested() -> bool;
    callback context-requested(FlyoutRect);
    callback context-requested-at(Point);

    private property <bool> dark: Palette.color-scheme == ColorScheme.dark;
    private property <bool> typed-since-empty;
    private property <bool> editing;
    private property <bool> pointer-peek: reveal-touch.pressed && reveal-touch.mouse-x >= 0px
        && reveal-touch.mouse-x < reveal-touch.width && reveal-touch.mouse-y >= 0px && reveal-touch.mouse-y < reveal-touch.height;
    private property <bool> key-peek;
    private property <bool> automation-peek;
    private property <bool> mask-cursor-on: true;
    private property <bool> can-peek: root.enabled && root.allow-peek && root.has-focus && root.typed-since-empty
        && root.password != "" && root.width > 70px && root.password-reveal-mode == PasswordRevealMode.peek;
    private property <string> published-password;
    private property <string> glyph: root.password-char == "●" ? "●" : PasswordBoxBehavior.mask-glyph(root.password-char);
    private property <bool> custom-mask: !root.is-password-revealed && root.glyph != "●" && root.glyph != "";
    private property <bool> mask-cursor-active: root.custom-mask && root.has-focus && !root.has-selection && root.enabled;
    private property <PasswordMask> masked: root.custom-mask ? PasswordBoxBehavior.mask-text(root.password, root.glyph,
        input.anchor-position-byte-offset, input.cursor-position-byte-offset) : {};
    private property <brush> ink: root.enabled ? Palette.foreground : root.dark ? #ffffff5c : #0000005c;

    min-width: 64px;
    preferred-width: 300px;
    min-height: layout.preferred-height;
    preferred-height: layout.preferred-height;
    forward-focus: input;

    init => { root.published-password = root.password; input.text = root.password; }
    changed password => {
        if input.text != root.password {
            input.text = root.password;
            input.set-selection-offsets(0, 0);
            root.typed-since-empty = false;
            root.automation-peek = false;
        }
        if root.password == "" { root.typed-since-empty = false; }
        root.notify-password-change();
    }
    changed has-focus => {
        if !root.has-focus {
            root.typed-since-empty = false;
            root.key-peek = false;
            root.automation-peek = false;
        }
    }
    changed enabled => {
        if !root.enabled {
            root.typed-since-empty = false;
            input.clear-focus();
        }
    }
    changed can-peek => {
        if !root.can-peek { root.key-peek = false; root.automation-peek = false; }
    }
    changed mask-cursor-active => { root.mask-cursor-on = true; }
    changed selection-cursor => {
        root.mask-cursor-on = true;
        mask-blink.restart();
    }

    mask-blink := Timer {
        running: root.mask-cursor-active;
        interval: 500ms;
        triggered => { root.mask-cursor-on = !root.mask-cursor-on; }
    }

    public function select-all() { if root.enabled { input.select-all(); } }

    public function set-selection-offsets(anchor: int, cursor: int) {
        if root.enabled { input.set-selection-offsets(anchor, cursor); }
    }

    public function paste() {
        if root.enabled && !root.paste-requested() { input.paste(); }
    }

    function notify-password-change() {
        if root.published-password != root.password {
            root.published-password = root.password;
            root.password-changing();
            root.password-changed();
        }
    }

    function apply-edit() {
        if root.editing { return; }
        root.editing = true;
        let previous = root.password;
        let edit = root.max-length > 0 ? PasswordBoxBehavior.limit-edit(previous, input.text,
            input.cursor-position-byte-offset, root.max-length) : { text: input.text, cursor: input.cursor-position-byte-offset };
        if edit.text != previous && root.before-password-changing(edit.text) {
            input.text = previous;
        } else {
            if edit.text != input.text {
                input.text = edit.text;
                input.set-selection-offsets(edit.cursor, edit.cursor);
            }
            if previous == "" && input.text != "" && root.has-focus { root.typed-since-empty = true; }
            if input.text == "" { root.typed-since-empty = false; }
            if previous != input.text { root.automation-peek = false; }
            root.password = input.text;
        }
        root.editing = false;
        root.notify-password-change();
    }

    function handle-key(event: KeyEvent) -> EventResult {
        let key = event.text.to-lowercase();
        if root.can-peek && event.text == Key.F8 && event.modifiers.alt {
            root.key-peek = true;
            return accept;
        }
        if event.text == Key.Escape && (root.key-peek || root.automation-peek) {
            root.key-peek = false;
            root.automation-peek = false;
            return accept;
        }
        if (event.modifiers.control || event.modifiers.meta) && !event.modifiers.alt {
            if key == "c" || key == "x" || key == "z" || key == "y" || event.text == Key.Insert { return accept; }
            if key == "v" && !event.modifiers.shift { root.paste(); return accept; }
        }
        if event.modifiers.shift && event.text == Key.Delete { return accept; }
        if event.modifiers.shift && event.text == Key.Insert { root.paste(); return accept; }
        return reject;
    }

    layout := VerticalLayout {
        spacing: 4px;
        alignment: start;
        if root.header != "": Text {
            text: root.header;
            font-size: 14px;
            color: root.ink;
            wrap: word-wrap;
            horizontal-alignment: root.rtl ? right : left;
            accessible-role: none;
        }

        area := ContextFlyoutArea {
            height: 32px;
            enabled: root.enabled;
            context-enabled: root.enabled && root.context-enabled;
            forward-focus: input;
            context-requested(anchor) => { root.context-requested(anchor); }
            context-requested-at(point) => { root.context-requested-at(point); }

            field := TextBoxField {
                width: parent.width;
                enabled: root.enabled;
                editing: root.has-focus;
                accent: root.accent;
                accessible-role: text-input;
                accessible-label: root.accessible-name;
                accessible-value: "";
                accessible-placeholder-text: root.placeholder-text;
                accessible-enabled: root.enabled;
                accessible-action-set-value(value) => { if root.enabled { root.password = value; } }
                forward-focus: input;

                // The accessibility backend derives the role and text runs from the first TextInput.
                // This password-typed proxy is always empty, including during visual reveal.
                TextInput {
                    width: 0px;
                    height: 0px;
                    visible: false;
                    enabled: false;
                    input-type: InputType.password;
                    accessible-role: none;
                }

                Rectangle {
                    x: root.rtl ? (root.can-peek ? 40px : 8px) : 12px;
                    y: 0px;
                    width: max(0px, parent.width - 20px - (root.can-peek ? 32px : 0px));
                    height: parent.height - 2px;
                    clip: true;

                    if root.password == "": Text {
                        width: parent.width;
                        height: parent.height;
                        text: root.placeholder-text;
                        vertical-alignment: center;
                        horizontal-alignment: root.rtl ? right : left;
                        font-size: 14px;
                        color: !root.enabled ? root.ink : root.dark ? #ffffffa6 : #0000009e;
                        overflow: elide;
                        accessible-role: none;
                    }

                    bullet-measure := Text { text: "●"; font-size: 14px; visible: false; accessible-role: none; }
                    glyph-measure := Text { text: root.glyph; font-size: 14px; visible: false; accessible-role: none; }

                    input := ScrollingTextInput {
                        viewport-width: parent.width;
                        height: parent.height;
                        enabled: root.enabled;
                        color: root.custom-mask ? transparent : root.ink;
                        selection-foreground-color: root.custom-mask ? transparent : Palette.accent-foreground;
                        letter-spacing: root.custom-mask ? glyph-measure.preferred-width - bullet-measure.preferred-width : 0px;
                        horizontal-alignment: root.rtl ? right : left;
                        input-type: root.is-password-revealed ? InputType.text : InputType.password;
                        input-method-hints: { capitalization: CapitalizationMode.none, auto-correct: false, auto-complete: false };
                        accessible-role: none;
                        edited => { root.apply-edit(); }
                        key-pressed(event) => { return root.handle-key(event); }
                        key-released(event) => {
                            if event.text == Key.F8 || event.text == Key.Alt { root.key-peek = false; }
                            return reject;
                        }
                    }

                    mask-text := Text {
                        x: input.x;
                        width: input.width;
                        height: input.height;
                        text: root.masked.display;
                        visible: root.custom-mask;
                        font-size: 14px;
                        color: root.ink;
                        horizontal-alignment: input.horizontal-alignment;
                        vertical-alignment: center;
                        accessible-role: none;
                    }
                    if root.custom-mask && root.has-selection: Text {
                        x: input.x + root.masked.selection-start * glyph-measure.preferred-width
                            + (root.rtl ? max(0px, input.width - mask-text.preferred-width) : 0px);
                        height: input.height;
                        text: root.masked.selected;
                        font-size: 14px;
                        color: Palette.accent-foreground;
                        vertical-alignment: center;
                        accessible-role: none;
                    }
                    if root.mask-cursor-active && root.mask-cursor-on: Rectangle {
                        x: input.x + root.masked.selection-start * glyph-measure.preferred-width
                            + (root.rtl ? max(0px, input.width - mask-text.preferred-width) : 0px);
                        y: (parent.height - self.height) / 2;
                        width: 1px;
                        height: 18px;
                        background: root.ink;
                    }
                }

                Rectangle {
                    x: root.rtl ? 4px : parent.width - self.width - 4px;
                    y: 4px;
                    width: 28px;
                    height: 24px;
                    visible: root.can-peek;
                    border-radius: 4px;
                    background: root.pointer-peek ? (root.dark ? #ffffff12 : #0000000a)
                        : reveal-touch.has-hover ? (root.dark ? #ffffff0f : #00000008) : transparent;
                    accessible-role: checkbox;
                    accessible-label: @tr("Show password");
                    accessible-checkable: true;
                    accessible-checked: root.is-password-revealed;
                    accessible-action-default => { if root.can-peek { root.automation-peek = !root.automation-peek; } }

                    Image {
                        width: 16px;
                        height: 16px;
                        x: (parent.width - self.width) / 2;
                        y: (parent.height - self.height) / 2;
                        source: @image-url("../../icons/eye_16_regular.svg");
                        colorize: root.dark ? #ffffff87 : #00000080;
                    }
                    reveal-touch := TouchArea { enabled: root.can-peek; }
                }
            }
        }

        if root.description != "": Text {
            text: root.description;
            font-size: 12px;
            color: root.enabled ? (root.dark ? #ffffffa6 : #0000009e) : root.ink;
            wrap: word-wrap;
            horizontal-alignment: root.rtl ? right : left;
        }
    }
}
