import { Palette } from "std-widgets.slint";
import { Button } from "../../ui/components/basic-input/button.slint";
import { GridView, GridViewBehavior, GridViewItem, GridViewSelectionMode, GridViewPresentation } from "../../ui/components/collections/grid_view.slint";

export { GridViewBehavior, GridViewItem, GridViewSelectionMode }

export component GridViewExample inherits Window {
    title: "GridView";
    min-width: 868px;
    preferred-height: 450px;
    background: Palette.color-scheme == ColorScheme.dark ? #202020 : #f3f3f3;
    in property <color> accent: Palette.accent-background;
    in-out property <[GridViewItem]> items;
    callback load-sample(bool);

    private property <bool> narrow;
    private property <bool> rtl;
    private property <bool> column-major;
    private property <bool> reorder-enabled;
    private property <bool> long-model;
    private property <int> mode;
    private property <int> template;
    private property <string> invoked;
    private property <int> reorders;

    VerticalLayout {
        padding: 24px;
        spacing: 14px;
        alignment: start;
        HorizontalLayout {
            alignment: start;
            spacing: 8px;
            Button { text: "Narrow"; clicked => { root.narrow = !root.narrow; } }
            Button { text: "Column flow"; clicked => { root.column-major = !root.column-major; } }
            Button { text: "Mirror RTL"; clicked => { root.rtl = !root.rtl; } }
            Button {
                text: root.mode == 0 ? "Single" : root.mode == 1 ? "Multiple" : root.mode == 2 ? "Extended" : "None";
                clicked => { root.mode = Math.mod(root.mode + 1, 4); }
            }
            Button { text: "Reorder"; clicked => { root.reorder-enabled = !root.reorder-enabled; } }
            Button { text: "Presentation"; clicked => { root.template = Math.mod(root.template + 1, 3); } }
            Button {
                text: "10,000 items";
                clicked => { root.long-model = !root.long-model; root.load-sample(root.long-model); }
            }
        }
        HorizontalLayout {
            alignment: start;
            grid := GridView {
                width: root.narrow ? 404px : 656px;
                height: 268px;
                accessible-name: "Photos";
                items <=> root.items;
                rtl: root.rtl;
                accent: root.accent;
                orientation: root.column-major ? Orientation.vertical : Orientation.horizontal;
                selection-mode: root.mode == 0 ? GridViewSelectionMode.single : root.mode == 1 ? GridViewSelectionMode.multiple
                    : root.mode == 2 ? GridViewSelectionMode.extended : GridViewSelectionMode.none;
                presentation: root.template == 0 ? GridViewPresentation.image : root.template == 1
                    ? GridViewPresentation.image-and-text : GridViewPresentation.text;
                can-drag-items: root.reorder-enabled;
                can-reorder-items: root.reorder-enabled;
                allow-drop: root.reorder-enabled;
                item-click-enabled: true;
                item-clicked(item) => { root.invoked = item.title; }
                items-reordered(ids, before) => { root.reorders += 1; }
            }
        }
        Rectangle {
            height: 20px;
            Text {
                x: 0px;
                text: "Selected \{grid.selected-ids.length} · Focus \{grid.focused-index} · Tracks \{grid.track-count} · Realized \{grid.realized-count} · Invoked \{root.invoked} · Reorders \{root.reorders}";
                color: Palette.foreground;
            }
        }
    }
}
