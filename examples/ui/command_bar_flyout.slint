import { Button, LineEdit, Palette } from "std-widgets.slint";
import { CommandBarBehavior, CommandBarEntry, CommandBarLayout, CommandBarOverflowButtonVisibility, AppBarLabelPosition }
    from "../../ui/components/menus-toolbars/command_bar.slint";
import { CommandBarFlyout, CommandBarFlyoutKeyScope, CommandBarFlyoutShowMode, CommandBarItem, CommandBarItemKind, FlyoutCloseReason, FlyoutPlacement }
    from "../../ui/components/menus-toolbars/command_bar_flyout.slint";
import { ContextFlyoutArea } from "../../ui/components/dialogs-flyouts/context_flyout_area.slint";
import { MenuFlyout, MenuFlyoutBehavior, MenuFlyoutItem, MenuFlyoutItemKind, MenuFlyoutLevel }
    from "../../ui/components/menus-toolbars/menu_flyout.slint";

export {
    AppBarLabelPosition, CommandBarBehavior, CommandBarEntry, CommandBarItem, CommandBarItemKind, CommandBarLayout,
    CommandBarOverflowButtonVisibility, MenuFlyoutBehavior, MenuFlyoutItem, MenuFlyoutItemKind, MenuFlyoutLevel,
}

export component CommandBarFlyoutExample inherits Window {
    title: "CommandBarFlyout";
    preferred-width: 472px;
    preferred-height: 392px;
    min-width: 256px;
    min-height: 224px;
    in property <bool> edge;
    in property <bool> always-expanded;
    in property <bool> secondary-only;
    in property <bool> primary-only;
    in property <bool> pointer-dismiss;
    private property <bool> return-to-editor;
    private property <bool> child-in-overflow;
    private property <string> result: "No command selected";

    CommandBarFlyoutKeyScope {
        width: parent.width;
        height: parent.height;
        dismiss-enabled: flyout.is-open && !export-menu.is-open;
        dismiss => { flyout.dismiss(FlyoutCloseReason.escape); }

        HorizontalLayout {
            x: 24px;
            y: 24px;
            width: parent.width - 48px;
            height: self.preferred-height;
            spacing: 8px;
            Button {
                text: "Show standard";
                clicked => {
                    root.return-to-editor = false;
                    context.focus();
                    flyout.show();
                }
            }
            Button {
                text: "Show transient";
                clicked => {
                    root.return-to-editor = true;
                    editor.focus();
                    if (root.pointer-dismiss) {
                        flyout.show-for({
                            x: self.absolute-position.x, y: self.absolute-position.y,
                            width: self.width, height: self.height,
                        }, CommandBarFlyoutShowMode.transient-with-dismiss-on-pointer-move-away);
                    } else {
                        flyout.show-for(flyout.anchor, CommandBarFlyoutShowMode.transient);
                    }
                }
            }
        }

        editor := LineEdit {
            x: 24px;
            y: 72px;
            width: parent.width - 48px;
            height: 32px;
            placeholder-text: "Type while the transient toolbar is showing";
            accessible-label: "Editor";
        }

        Text {
            x: 24px;
            y: 118px;
            text: root.result;
        }

        context := ContextFlyoutArea {
            x: 24px;
            y: root.edge ? parent.height - 68px : 152px;
            width: 160px;
            height: 44px;
            accessible-role: groupbox;
            accessible-label: "Context target";
            context-requested(anchor) => {
                root.return-to-editor = false;
                flyout.show-for(anchor, CommandBarFlyoutShowMode.standard);
            }
            context-requested-at(position) => {
                root.return-to-editor = false;
                self.focus();
                flyout.show-at(position, CommandBarFlyoutShowMode.standard);
            }
            Rectangle {
                background: Palette.alternate-background;
                border-radius: 4px;
                border-width: context.has-focus ? 2px : 1px;
                border-color: context.has-focus ? Palette.foreground : Palette.border;
                Text {
                    text: "Context target";
                    horizontal-alignment: center;
                    vertical-alignment: center;
                    accessible-role: none;
                }
            }
        }

        flyout := CommandBarFlyout {
            width: parent.width;
            height: parent.height;
            anchor: {
                x: context.absolute-position.x, y: context.absolute-position.y,
                width: context.width, height: context.height,
            };
            placement: FlyoutPlacement.bottom-edge-aligned-left;
            always-expanded: root.always-expanded;
            primary-commands: root.secondary-only ? [] : [
                { id: "pin", label: "Pin", kind: CommandBarItemKind.toggle,
                    icon: @image-url("../../ui/icons/pin_16_regular.svg") },
                { id: "copy", label: "Copy", icon: @image-url("../../ui/icons/copy_16_regular.svg") },
                { kind: CommandBarItemKind.separator },
                { id: "share", label: "Share", disabled: true,
                    icon: @image-url("../../ui/icons/share_16_regular.svg") },
            ];
            secondary-commands: root.primary-only ? [] : [
                { id: "rename", label: "Rename", icon: @image-url("../../ui/icons/edit_16_regular.svg") },
                { id: "duplicate", label: "Duplicate", icon: @image-url("../../ui/icons/copy_16_regular.svg") },
                { kind: CommandBarItemKind.separator },
                { id: "export", label: "Export", has-flyout: true, flyout-open: export-menu.is-open,
                    icon: @image-url("../../ui/icons/arrow_export_16_regular.svg") },
            ];
            restore-focus => { if (root.return-to-editor) { editor.focus(); } else { context.focus(); } }
            invoked(item) => {
                root.result = item.kind == CommandBarItemKind.toggle
                    ? item.label + (item.checked ? " on" : " off") : item.label + " selected";
            }
            open-flyout(item, anchor, overflow) => {
                root.child-in-overflow = overflow;
                export-menu.show-for(anchor);
            }
        }

        export-menu := MenuFlyout {
            width: parent.width;
            height: parent.height;
            placement: root.child-in-overflow ? FlyoutPlacement.right-edge-aligned-top : FlyoutPlacement.bottom-edge-aligned-left;
            items: [{ id: "pdf", text: "PDF" }, { id: "image", text: "Image" }];
            invoked(item) => { root.result = item.text + " selected"; }
        }
    }
}
