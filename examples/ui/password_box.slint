import { Button, CheckBox, Palette } from "std-widgets.slint";
import { PasswordBox, PasswordBoxBehavior, PasswordMask, PasswordEdit, PasswordRevealMode }
    from "../../ui/components/text/password_box.slint";
import { AppBarLabelPosition, CommandBarBehavior, CommandBarEntry, CommandBarItem,
    CommandBarItemKind, CommandBarLayout, CommandBarOverflowButtonVisibility }
    from "../../ui/components/menus-toolbars/command_bar.slint";
import { CommandBarFlyoutKeyScope } from "../../ui/components/menus-toolbars/command_bar_flyout.slint";
import { FlyoutCloseReason, FlyoutRect, TextCommand, TextCommandBarFlyout, TextCommandTarget }
    from "../../ui/components/text/text_command_bar_flyout.slint";

export { PasswordBoxBehavior, PasswordMask, PasswordEdit, AppBarLabelPosition,
    CommandBarBehavior, CommandBarEntry, CommandBarItem, CommandBarItemKind, CommandBarLayout, CommandBarOverflowButtonVisibility }

export component PasswordBoxExample inherits Window {
    title: "PasswordBox";
    min-width: 560px;
    preferred-width: 640px;
    preferred-height: 480px;
    default-font-family: "Segoe UI Variable Text";
    background: #f3f3f3;
    in property <color> accent: #005fb8;
    private property <bool> reveal;
    private property <bool> compact;
    private property <bool> disable;
    private property <bool> rejected;
    private property <int> edits;
    private property <bool> clipboard-has-text;
    callback clipboard-contains-text() -> bool;

    CommandBarFlyoutKeyScope {
        width: parent.width;
        height: parent.height;
        dismiss-enabled: menu.is-open;
        dismiss => { menu.dismiss(FlyoutCloseReason.escape); }

        VerticalLayout {
            x: 24px;
            y: 20px;
            width: parent.width - 48px;
            height: self.preferred-height;
            spacing: 12px;
            alignment: start;

            Text { text: "A simple PasswordBox"; font-size: 16px; font-weight: 600; }
            simple := PasswordBox {
                width: root.compact ? 64px : 300px;
                accent: root.accent;
                enabled: !root.disable;
                accessible-name: "Simple PasswordBox";
                context-requested(anchor) => {
                    root.clipboard-has-text = root.clipboard-contains-text();
                    menu.show-context(anchor);
                }
                context-requested-at(point) => {
                    self.focus();
                    root.clipboard-has-text = root.clipboard-contains-text();
                    menu.show-context-at(point);
                }
                before-password-changing(draft) => {
                    root.rejected = draft == "Password";
                    return root.rejected;
                }
                password-changed => { root.edits += 1; }
            }
            if root.rejected: Text { text: "'Password' is not allowed."; color: #c42b1c; }

            Text { text: "Header, placeholder and custom character"; font-size: 16px; font-weight: 600; }
            custom := PasswordBox {
                width: 300px;
                accent: root.accent;
                enabled: !root.disable;
                header: "Password";
                placeholder-text: "Enter your password";
                password-char: "#";
                max-length: 12;
                context-enabled: false;
            }

            Text { text: "Change the reveal mode"; font-size: 16px; font-weight: 600; }
            HorizontalLayout {
                alignment: start;
                spacing: 8px;
                height: 32px;
                mode := PasswordBox {
                    width: 250px;
                    accent: root.accent;
                    accessible-name: "Sample password box";
                    enabled: !root.disable;
                    password-reveal-mode: root.reveal ? PasswordRevealMode.visible : PasswordRevealMode.hidden;
                    context-enabled: false;
                }
                CheckBox { text: "Show password"; checked <=> root.reveal; }
            }

            HorizontalLayout {
                alignment: start;
                spacing: 8px;
                height: 32px;
                Button { text: "Set sample value"; clicked => { simple.password = "example"; } }
                Button { text: "Clear"; clicked => { simple.password = ""; } }
                Button { text: "Narrow"; checkable: true; checked <=> root.compact; }
                Button { text: "Disable fields"; checkable: true; checked <=> root.disable; }
            }
            Text { text: "Changes: \{root.edits}"; color: Palette.foreground; }
        }

        menu := TextCommandBarFlyout {
            width: parent.width;
            height: parent.height;
            target-kind: TextCommandTarget.password-box;
            can-paste: root.clipboard-has-text;
            has-text: simple.password != "";
            has-selection: simple.has-selection;
            invoked(command) => {
                if command == TextCommand.paste { simple.paste(); }
                else if command == TextCommand.select-all { simple.select-all(); }
            }
            restore-focus => { simple.focus(); }
        }
    }
}
