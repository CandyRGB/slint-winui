import { Palette } from "std-widgets.slint";
import { Button, WindowTitleBar } from "../../ui/lib.slint";

export component WindowTitleBarExample inherits Window {
    title: "WindowTitleBar";
    preferred-width: 760px;
    preferred-height: 400px;
    min-width: 380px;
    min-height: 240px;
    background: root.caption-extended ? transparent : Palette.background;
    in property <bool> caption-extended;
    in property <length> maximized-caption-inset;
    out property <length> caption-height: caption.preferred-row-height;
    out property <length> caption-controls-width: caption.interactive-width;
    out property <color> caption-background: Palette.background;
    out property <color> caption-foreground: Palette.foreground;
    callback caption-controls-changed();
    callback caption-colors-changed();
    private property <length> caption-top: root.caption-extended && root.maximized
        ? root.maximized-caption-inset : 0px;
    private property <length> caption-bottom: root.caption-extended
        ? root.caption-top + root.caption-height : 0px;
    private property <bool> show-back: true;
    private property <bool> pane-open: true;
    private property <string> last-action: "Select an action in the title bar.";

    changed caption-controls-width => { root.caption-controls-changed(); }
    changed caption-background => { root.caption-colors-changed(); }
    changed caption-foreground => { root.caption-colors-changed(); }

    Rectangle {
        x: 0px;
        y: root.caption-bottom;
        width: parent.width;
        height: parent.height - self.y;
        background: Palette.background;

        VerticalLayout {
            padding: 20px;
            spacing: 12px;
            alignment: start;
            Text { text: root.last-action; color: Palette.foreground; }
            Button {
                text: root.show-back ? "Hide back button" : "Show back button";
                clicked => { root.show-back = !root.show-back; }
            }
        }
    }

    caption := WindowTitleBar {
        x: 0px;
        y: root.caption-top;
        width: parent.width;
        height: root.caption-height;
        visible: root.caption-extended;
        title: root.title;
        show-back-button: root.show-back;
        show-pane-toggle-button: true;
        pane-open: root.pane-open;
        back-requested => { root.last-action = "Back requested"; }
        pane-toggle-requested => {
            root.pane-open = !root.pane-open;
            root.last-action = root.pane-open ? "Navigation opened" : "Navigation closed";
        }
    }
}
